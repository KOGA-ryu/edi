  "ascii": {
    "backend": "tool_plan_dryrun",
    "width": 80,
    "height": 50,
    "projection": "front_side_top",
    "custom_palette": "",
    "edge_mode": "none",
    "save_txt": true,
    "save_png": false
  },
  "glyph_preview": {
    "backend": "glyph_lab.render_ascii_glyphs",
    "font_repo": "/Users/kogaryu/font",
    "glyph_pack": "/Users/kogaryu/font/packs/stone_architecture_4x4",
    "renderer_python": "/Users/kogaryu/font/.venv/bin/python",
    "input_root": "/tmp/draftsman_blender_recipe_lab_tool_plan/ascii_dryrun",
    "output_root": "/tmp/draftsman_blender_recipe_lab_tool_plan/glyph_preview",
    "projection": "front_side_top",
