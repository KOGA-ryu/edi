  },
  "validation": {
    "json_parse_check": true,
    "template_contract_check": true,
    "tool_plan_ui_check": true,
    "asset_schema_check": true,
    "adapter_validate_only": true,
    "full_pipeline_gate": false
  },
  "output_safety": {
    "tmp_only_outputs": true,
    "clean_before_run": true,
    "repo_output_guard": true
  },
  "review": {
    "capture_rejected_preview": true,
    "correction_note_path": "docs/scratch/blender_recipe_lab_corrections_v0.md",
    "source_change_target": "current_bundle"
