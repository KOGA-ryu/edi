  },
  "profile_revolve": {
    "axis": "z",
    "segments": 24,
    "material_role": "stone_shaft",
    "show_profile_graph": true,
    "show_ring_preview": true
  },
  "tool_plan": {
    "tool_filter": "exec",
    "stage_lock": true,
    "auto_renumber_steps": true,
    "show_dependency_warnings": true,
    "allow_raw_param_edit": false,
    "validate_on_change": true
