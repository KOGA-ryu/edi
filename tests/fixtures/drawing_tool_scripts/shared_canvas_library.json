{
  "points": {
    "lineStart": { "x": 128, "y": 128 },
    "lineStartMoved": { "x": 96, "y": 160 },
    "lineEnd": { "x": 256, "y": 128 },
    "lineEndMoved": { "x": 320, "y": 160 },
    "pointCreate": { "x": 96, "y": 352 },
    "pointMoved": { "x": 128, "y": 384 },
    "circleCenter": { "x": 256, "y": 256 },
    "circleCenterMoved": { "x": 288, "y": 288 },
    "circleRadius": { "x": 320, "y": 256 },
    "circleRadiusMoved": { "x": 352, "y": 256 },
    "rectStart": { "x": 96, "y": 256 },
    "rectStartMoved": { "x": 64, "y": 224 },
    "rectEnd": { "x": 192, "y": 320 },
    "rectEndMoved": { "x": 224, "y": 352 },
    "moveStart": { "x": 192, "y": 128 },
    "moveEnd": { "x": 256, "y": 160 },
    "marqueeStart": { "x": 96, "y": 96 },
    "marqueeEnd": { "x": 360, "y": 220 }
  },
  "budgets": {
    "cheapClick": {
      "maxControllerMutations": 1,
      "maxRenderRequests": 1
    },
    "handleDrag": {
      "maxMutationsPerPointerMove": 2.1,
      "maxRenderRequestsPerPointerMove": 1.25,
      "maxHitTestsPerPointerMove": 0.25
    },
    "singleFieldHandleDrag": {
      "maxMutationsPerPointerMove": 1.1,
      "maxRenderRequestsPerPointerMove": 1.25,
      "maxHitTestsPerPointerMove": 0.25
    },
    "rectangleCornerHandleDrag": {
      "maxMutationsPerPointerMove": 4.1,
      "maxRenderRequestsPerPointerMove": 1.25,
      "maxHitTestsPerPointerMove": 0.25
    },
    "objectDrag": {
      "maxMutationsPerPointerMove": 1.1,
      "maxRenderRequestsPerPointerMove": 1.25,
      "maxHitTestsPerPointerMove": 0.25
    },
    "marquee": {
      "maxRenderRequestsPerPointerMove": 1.25,
      "maxHitTestsPerPointerMove": 0.25
    },
    "pan": {
      "maxControllerMutations": 1,
      "maxRenderRequests": 1
    }
  },
  "fragments": {
    "selectLineTool": [
      { "type": "selectTool", "toolId": "line_polyline" }
    ],
    "selectPointTool": [
      { "type": "selectTool", "toolId": "anchor_points" }
    ],
    "selectCircleTool": [
      { "type": "selectTool", "toolId": "circle_arc" }
    ],
    "selectRectangleTool": [
      { "type": "selectTool", "toolId": "rectangle_polygon" }
    ],
    "selectMoveTool": [
      { "type": "selectTool", "toolId": "select_move" }
    ],
    "createBasicLine": [
      { "use": "selectLineTool" },
      { "type": "clickCanvas", "point": "lineStart" },
      { "type": "clickCanvas", "point": "lineEnd" }
    ],
    "createBasicPoint": [
      { "use": "selectPointTool" },
      { "type": "clickCanvas", "point": "pointCreate" }
    ],
    "createBasicCircle": [
      { "use": "selectCircleTool" },
      { "type": "clickCanvas", "point": "circleCenter" },
      { "type": "clickCanvas", "point": "circleRadius" }
    ],
    "createBasicArc": [
      { "use": "selectCircleTool" },
      { "type": "setToolParameter", "parameter": "circle_arc_mode", "value": "arc" },
      { "type": "setToolParameter", "parameter": "circle_arc_start_angle_deg", "value": 15 },
      { "type": "setToolParameter", "parameter": "circle_arc_end_angle_deg", "value": 120 },
      { "type": "clickCanvas", "point": "circleCenter" },
      { "type": "clickCanvas", "point": "circleRadius" }
    ],
    "createBasicRectangle": [
      { "use": "selectRectangleTool" },
      { "type": "clickCanvas", "point": "rectStart" },
      { "type": "clickCanvas", "point": "rectEnd" }
    ],
    "createPentagon": [
      { "type": "selectTool", "toolId": "regular_polygon" },
      { "type": "setToolParameter", "parameter": "regular_polygon_sides", "value": 5 },
      { "type": "setToolParameter", "parameter": "regular_polygon_rotation_deg", "value": 18 },
      { "type": "clickCanvas", "point": "circleCenter" },
      { "type": "clickCanvas", "point": "circleRadius" }
    ]
  }
}
