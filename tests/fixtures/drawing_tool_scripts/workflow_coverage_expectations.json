{
  "schemaVersion": 1,
  "minimums": {
    "kinds": {
      "line": 5,
      "point": 2,
      "circle": 3,
      "rectangle": 3,
      "arc": 1,
      "polygon": 1,
      "viewport": 1
    },
    "categories": {
      "create": 6,
      "edit": 7,
      "move": 1,
      "selection": 1,
      "viewport": 1
    },
    "tags": {
      "geometry": 14,
      "handle": 7,
      "line": 5,
      "smoke": 4,
      "parameter": 2,
      "viewport": 1
    }
  },
  "selectors": [
    {
      "id": "line_tag",
      "env": {
        "DRAWING_WORKFLOW_TAG": "line"
      },
      "minimums": {
        "kinds": {
          "line": 5
        },
        "categories": {
          "create": 1,
          "edit": 2,
          "move": 1,
          "selection": 1
        },
        "tags": {
          "line": 5,
          "geometry": 4,
          "handle": 2
        }
      }
    },
    {
      "id": "edit_category",
      "env": {
        "DRAWING_WORKFLOW_CATEGORY": "edit"
      },
      "minimums": {
        "kinds": {
          "line": 2,
          "point": 1,
          "circle": 2,
          "rectangle": 2
        },
        "categories": {
          "edit": 7
        },
        "tags": {
          "handle": 7,
          "geometry": 7
        }
      }
    },
    {
      "id": "arc_fixture",
      "env": {
        "DRAWING_WORKFLOW_FIXTURE": "arc_create_basic.json"
      },
      "minimums": {
        "kinds": {
          "arc": 1
        },
        "categories": {
          "create": 1
        },
        "tags": {
          "arc": 1,
          "parameter": 1,
          "geometry": 1
        }
      }
    }
  ],
  "recommendedSelectors": [
    {
      "id": "line_system",
      "selectorId": "line_tag",
      "description": "Line create, edit, move, and selection coverage.",
      "command": "build/drawing_control_workflow_report --tag line --dry-run --compact",
      "runCommand": "build/drawing_control_workflow_report --tag line",
      "baselineCommand": "build/drawing_control_workflow_report --tag line --compare-baseline",
      "failureCommand": "build/drawing_control_workflow_report --tag line --compare-baseline --failures-only",
      "failureCommands": {
        "controller": "build/drawing_control_workflow_report --tag line --compare-baseline --subsystem controller --failures-only",
        "gesture": "build/drawing_control_workflow_report --tag line --compare-baseline --subsystem gesture --failures-only",
        "handles": "build/drawing_control_workflow_report --tag line --compare-baseline --subsystem handles --failures-only",
        "hit_test": "build/drawing_control_workflow_report --tag line --compare-baseline --subsystem hit_test --failures-only",
        "rendering": "build/drawing_control_workflow_report --tag line --compare-baseline --subsystem rendering --failures-only",
        "snap": "build/drawing_control_workflow_report --tag line --compare-baseline --subsystem snap --failures-only"
      }
    },
    {
      "id": "handle_edits",
      "selectorId": "edit_category",
      "description": "Editable handle coverage across line, point, circle, and rectangle.",
      "command": "build/drawing_control_workflow_report --category edit --dry-run --compact",
      "runCommand": "build/drawing_control_workflow_report --category edit",
      "baselineCommand": "build/drawing_control_workflow_report --category edit --compare-baseline",
      "failureCommand": "build/drawing_control_workflow_report --category edit --compare-baseline --failures-only",
      "failureCommands": {
        "controller": "build/drawing_control_workflow_report --category edit --compare-baseline --subsystem controller --failures-only",
        "gesture": "build/drawing_control_workflow_report --category edit --compare-baseline --subsystem gesture --failures-only",
        "handles": "build/drawing_control_workflow_report --category edit --compare-baseline --subsystem handles --failures-only",
        "rendering": "build/drawing_control_workflow_report --category edit --compare-baseline --subsystem rendering --failures-only"
      }
    },
    {
      "id": "arc_parameters",
      "selectorId": "arc_fixture",
      "description": "Arc parameter workflow for exact fixture checks.",
      "command": "build/drawing_control_workflow_report --fixture arc_create_basic.json --dry-run --compact",
      "runCommand": "build/drawing_control_workflow_report --fixture arc_create_basic.json",
      "baselineCommand": "build/drawing_control_workflow_report --fixture arc_create_basic.json --compare-baseline",
      "failureCommand": "build/drawing_control_workflow_report --fixture arc_create_basic.json --compare-baseline --failures-only"
    },
    {
      "id": "all_workflows",
      "description": "Full workflow coverage overview.",
      "command": "build/drawing_control_workflow_report --all --dry-run --compact",
      "runCommand": "build/drawing_control_workflow_report --all",
      "baselineCommand": "build/drawing_control_workflow_report --all --compare-baseline",
      "failureCommand": "build/drawing_control_workflow_report --all --compare-baseline --failures-only",
      "failureCommands": {
        "baseline": "build/drawing_control_workflow_report --all --compare-baseline --subsystem baseline --failures-only",
        "controller": "build/drawing_control_workflow_report --all --compare-baseline --subsystem controller --failures-only",
        "gesture": "build/drawing_control_workflow_report --all --compare-baseline --subsystem gesture --failures-only",
        "handles": "build/drawing_control_workflow_report --all --compare-baseline --subsystem handles --failures-only",
        "hit_test": "build/drawing_control_workflow_report --all --compare-baseline --subsystem hit_test --failures-only",
        "metrics": "build/drawing_control_workflow_report --all --compare-baseline --subsystem metrics --failures-only",
        "rendering": "build/drawing_control_workflow_report --all --compare-baseline --subsystem rendering --failures-only",
        "snap": "build/drawing_control_workflow_report --all --compare-baseline --subsystem snap --failures-only",
        "workflow_fixture": "build/drawing_control_workflow_report --all --compare-baseline --subsystem workflow_fixture --failures-only"
      }
    }
  ]
}
