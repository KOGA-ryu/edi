{
  "schemaVersion": 1,
  "policy": {
    "maxFailures": 5
  },
  "budgets": [
    {
      "id": "draw_click_baseline",
      "match": {
        "mode": "draw_click"
      },
      "limits": {
        "maxDurationMs": 20,
        "maxControllerMutations": 1,
        "maxRenderRequests": 1,
        "maxHitTests": 0,
        "maxSnapResolutions": 1,
        "maxHandlePlans": 0,
        "maxRevisionDelta": 1
      }
    },
    {
      "id": "handle_drag_baseline",
      "match": {
        "mode": "dragging_handle"
      },
      "limits": {
        "maxDurationMs": 100,
        "maxPointerMoves": 8,
        "maxMutationsPerPointerMove": 4.1,
        "maxRenderRequestsPerPointerMove": 1.25,
        "maxHitTestsPerPointerMove": 0.25,
        "maxSnapResolutionsPerPointerMove": 1.25,
        "maxHandlePlansPerPointerMove": 1.25
      }
    },
    {
      "id": "object_drag_baseline",
      "match": {
        "mode": "dragging_object"
      },
      "limits": {
        "maxDurationMs": 50,
        "maxPointerMoves": 8,
        "maxMutationsPerPointerMove": 1.1,
        "maxRenderRequestsPerPointerMove": 1.25,
        "maxHitTestsPerPointerMove": 0.25,
        "maxSnapResolutionsPerPointerMove": 1.25,
        "maxHandlePlans": 0
      }
    },
    {
      "id": "marquee_baseline",
      "match": {
        "mode": "marquee_select"
      },
      "limits": {
        "maxDurationMs": 50,
        "maxPointerMoves": 16,
        "maxMutationsPerPointerMove": 0.25,
        "maxRenderRequestsPerPointerMove": 1.25,
        "maxHitTestsPerPointerMove": 0.25,
        "maxSnapResolutions": 0,
        "maxHandlePlans": 0
      }
    },
    {
      "id": "pan_baseline",
      "match": {
        "mode": "panning"
      },
      "limits": {
        "maxDurationMs": 50,
        "maxControllerMutations": 1,
        "maxRenderRequests": 1,
        "maxHitTests": 0,
        "maxSnapResolutions": 0,
        "maxHandlePlans": 0
      }
    },
    {
      "id": "line_workflows",
      "match": {
        "kind": "line"
      },
      "limits": {
        "maxDurationMs": 100,
        "maxMutationsPerPointerMove": 2.1,
        "maxRenderRequestsPerPointerMove": 1.25,
        "maxHitTestsPerPointerMove": 0.25
      }
    },
    {
      "id": "edit_workflows",
      "match": {
        "category": "edit"
      },
      "limits": {
        "maxDurationMs": 100,
        "maxPointerMoves": 8,
        "maxMutationsPerPointerMove": 4.1,
        "maxRenderRequestsPerPointerMove": 1.25,
        "maxHitTestsPerPointerMove": 0.25
      }
    }
  ]
}
